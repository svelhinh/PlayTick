{
    "@@locale": "en",
    "appName": "Play Tick",
    "@appName": {
        "type": "text",
        "description": "The name of the app"
    },
    "navigationLabelHome": "Home",
    "@navigationLabelHome": {
        "type": "text",
        "description": "The label of the home navigation item"
    },
    "navigationLabelLibrary": "Library",
    "@navigationLabelLibrary": {
        "type": "text",
        "description": "The label of the library navigation item"
    },
    "homeEmptyCardTitle": "No game in progress",
    "@homeEmptyCardTitle": {
        "type": "text",
        "description": "The title of the empty card in the home screen"
    },
    "homeEmptyCardDescription": "Add a game to your library to start tracking your sessions.",
    "@homeEmptyCardDescription": {
        "type": "text",
        "description": "The description of the empty card in the home screen"
    },
    "homeEmptyCardButtonText": "Go to library",
    "@homeEmptyCardButtonText": {
        "type": "text",
        "description": "The text of the button in the empty card in the home screen"
    },
    "libraryTitle": "Library",
    "@libraryTitle": {
        "type": "text",
        "description": "The title of the library screen"
    },
    "librarySubtitle": "Your game collection",
    "@librarySubtitle": {
        "type": "text",
        "description": "The subtitle of the library screen"
    },
    "libraryEmptyStateTitle": "Your library is empty",
    "@libraryEmptyStateTitle": {
        "type": "text",
        "description": "The title of the empty card in the library screen"
    },
    "libraryEmptyStateDescription": "Add your first game to start tracking your progress.",
    "@libraryEmptyStateDescription": {
        "type": "text",
        "description": "The description of the empty card in the library screen"
    },
    "gameStatusWantToPlay": "Want to play",
    "@gameStatusWantToPlay": {
        "type": "text",
        "description": "The status of the game 'Want to play'"
    },
    "gameStatusPlaying": "Playing",
    "@gameStatusPlaying": {
        "type": "text",
        "description": "The status of the game 'Playing'"
    },
    "gameStatusCompleted": "Completed",
    "@gameStatusCompleted": {
        "type": "text",
        "description": "The status of the game 'Completed'"
    },
    "gameStatusDropped": "Dropped",
    "@gameStatusDropped": {
        "type": "text",
        "description": "The status of the game 'Dropped'"
    },
    "gamePlaytime": "{hours} h {minutes}",
    "@gamePlaytime": {
        "type": "text",
        "description": "The playtime of the game",
        "placeholders": {
            "hours": {
                "type": "int"
            },
            "minutes": {
                "type": "String"
            }
        }
    },
    "libraryGamesCount": "{count, plural, =0{No games} =1{1 game} other{{count} games}}",
    "@libraryGamesCount": {
        "type": "text",
        "description": "Number of games in the library",
        "placeholders": {
            "count": {
                "type": "int"
            }
        }
    }
}